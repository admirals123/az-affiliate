# ──────────────────────────────────────────────
# DealHunt — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ──────────────────────────────────────────────

# Amazon Product Advertising API credentials
# Get these at: https://affiliate-program.amazon.com → Tools → Product Advertising API
AMAZON_ACCESS_KEY=your_access_key_here
AMAZON_SECRET_KEY=your_secret_key_here
AMAZON_PARTNER_TAG=your-tag-20

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Secret to manually trigger the bot via POST /api/bot/run
BOT_SECRET=change-this-to-a-random-secret
