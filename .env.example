# ──────────────────────────────────────────────
# DealHunt — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ──────────────────────────────────────────────

# Your Amazon Associates partner/tracking tag (e.g. mytag-20)
# Sign up at https://affiliate-program.amazon.com
# No PA API credentials needed — the bot scrapes public deal pages.
AMAZON_PARTNER_TAG=your-tag-20

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Secret to manually trigger the bot via POST /api/bot/run
BOT_SECRET=change-this-to-a-random-secret
